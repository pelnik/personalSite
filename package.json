{
  "name": "personalsite",
  "version": "2.0.0",
  "description": "My personal site in React",
  "main": "index.js",
  "scripts": {
    "build": "react-scripts build",
    "start": "PORT=3001 react-scripts start",
    "start:dev": "NODE_ENV=development nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "seed:juicebox": "node ./src/api/juicebox/db/seed.js",
    "seed:fitness": "node ./src/api/fitness-tracker/db/seed.js",
    "seed:scents": "node ./src/api/scents/db/seed.js",
    "seed:all": "npm run seed:juicebox && npm run seed:fitness && npm run seed:scents",
    "test": "jest",
    "test:fitness": "JEST_ENV=fitness jest --runInBand",
    "test:frontend": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelnik/personalSite.git"
  },
  "keywords": [
    "react"
  ],
  "author": "Matt Pelnik",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pelnik/personalSite/issues"
  },
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/joy": "^5.0.0-alpha.72",
    "@mui/material": "^6.1.9",
    "axios": "^1.3.4",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.0.1",
    "react-scripts": "^5.0.1",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@faker-js/faker": "^9.2.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "babel-jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2",
    "typescript": "^4.9.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
