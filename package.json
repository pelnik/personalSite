{
  "name": "personalsite",
  "version": "2.0.0",
  "description": "My personal site in React",
  "main": "index.js",
  "scripts": {
    "predev": "lsof -ti :3000,:3001 | xargs kill -9 2>/dev/null; true",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "prod": "NODE_ENV=production node server.js",
    "client:dev": "vite",
    "server:dev": "NODE_ENV=development nodemon server.js",
    "build": "vite build && node scripts/prerender.mjs",
    "seed:juicebox": "node ./src/api/juicebox/db/seed.js",
    "seed:fitness": "node ./src/api/fitness-tracker/db/seed.js",
    "seed:scents": "node ./src/api/scents/db/seed.js",
    "seed:auth": "node ./src/api/auth/db/seed.js",
    "auth:make-admin": "node scripts/make-admin.js",
    "seed:all": "npm run seed:auth && npm run seed:juicebox && npm run seed:fitness && npm run seed:scents",
    "test": "npm run test:api",
    "test:fitness": "jest --selectProjects fitness --runInBand",
    "test:api": "jest --runInBand",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:functional": "playwright test --project=functional",
    "typecheck": "tsc --noEmit",
    "metrics:report": "node scripts/memory-report.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pelnik/personalSite.git"
  },
  "keywords": [
    "react"
  ],
  "author": "Matt Pelnik",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pelnik/personalSite/issues"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.12.1",
    "pg": "^8.10.0",
    "stripe": "^17.4.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@faker-js/faker": "^9.2.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/joy": "^5.0.0-alpha.72",
    "@mui/material": "^6.1.9",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "jest": "^29.5.0",
    "nodemon": "^3.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "engines": {
    "node": ">=24"
  }
}
