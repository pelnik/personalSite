# =============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# JWT Authentication
# JWT secret for signing tokens - use a strong random string (32+ characters)
# Generate one with: openssl rand -base64 32
JWT_SECRET="your-secret-key-here"

# Database URLs (for local development without Docker)
DATABASE_URL="postgres://localhost:5432/juicebox"
FITNESS_DATABASE_URL="postgres://localhost:5432/fitness"
SCENTS_DATABASE_URL="postgres://localhost:5432/scents"

# API URL
API_URL="http://localhost:3000/api/fitness"

# Server Environment
SERVER_ENV="development"

# Stripe Keys (for payment processing)
STRIPE_KEY="sk_test_..."
PROD_STRIPE_KEY="sk_live_..."


# =============================================================================
# Production-only variables (for docker-compose.prod.yml)
# =============================================================================

# Database credentials for Docker Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-password-here"

# Monitoring
# Enables GET /api/metrics (send "Authorization: Bearer <token>"). Leave empty
# to keep it disabled. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=""
# How often server.js logs a metrics line, in ms (default 300000; 0 = off)
METRICS_INTERVAL_MS=""
