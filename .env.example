# =============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# JWT Authentication
JWT_SECRET="your-secret-key-here"

# Database URLs (for local development without Docker)
DATABASE_URL="postgres://localhost:5432/juicebox"
FITNESS_DATABASE_URL="postgres://localhost:5432/fitness"
SCENTS_DATABASE_URL="postgres://localhost:5432/scents"

# API URL
API_URL="http://localhost:3000/api/fitness"

# Server Environment
SERVER_ENV="development"

# Stripe Keys (for payment processing)
STRIPE_KEY="sk_test_..."
PROD_STRIPE_KEY="sk_live_..."

# GitHub Webhooks (optional)
GITHUB_WEBHOOK=""
GITHUB_WEBHOOK2=""

# =============================================================================
# Production-only variables (for docker-compose.prod.yml)
# =============================================================================

# Database credentials for Docker Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-password-here"
